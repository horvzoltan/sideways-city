{
  "name": "sideways-city",
  "productName": "Sideways City",
  "version": "1.0.0",
  "description": "Top-down drifting game",
  "author": "horvzoltan",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.horvzoltan.sidewayscity",
    "productName": "Sideways City",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "desktop/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "desktopName": "sideways-city.desktop"
}
